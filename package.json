{
  "name": "flick",
  "version": "0.1.0",
  "description": "Flick task manager on Cloudflare",
  "scripts": {
    "dev": "vite build && wrangler dev",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply flick-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flick-db --remote",
    "deploy": "vite build && wrangler d1 migrations apply flick-db --remote && wrangler deploy",
    "test:e2e": "playwright test"
  },
  "license": "MIT",
  "dependencies": {
    "arctic": "^3.7.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
